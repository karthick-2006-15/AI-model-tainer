# =====================================================================
# JARVIS — Environment Configuration Template (MARK VII)
# Copy this file to .env and adjust variables as needed.
# =====================================================================

# Server & Host Configuration
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
JARVIS_DEBUG=true
JARVIS_SECRET_KEY=change_this_to_a_secure_random_hex_key_for_device_pairing

# Database & Storage
DATABASE_URL=sqlite:///./jarvis.db
QDRANT_STORAGE_PATH=./storage/vector_data

# AI Model Providers (Configure at least one or use local Ollama / offline kernel)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Local Ollama Settings (Optional - 100% Free / Offline)
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LOCAL_MODEL=llama3.2:3b

# Voice Engine Settings
WAKE_WORD=hey_jarvis
WAKE_WORD_SENSITIVITY=0.5
WHISPER_MODEL_SIZE=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TTS_ENGINE=edge_tts
DEFAULT_VOICE_EN=en-US-ChristopherNeural
DEFAULT_VOICE_TA=ta-IN-ValluvarNeural

# Security & Permissions
DEFAULT_PERMISSION_LEVEL=1
AUTO_APPROVE_LEVEL_2=true
LEVEL_3_TIMEOUT_SECONDS=60
EMERGENCY_STOP_ENABLED=true

# Monitored File Paths (Comma-separated)
INDEXED_DIRECTORIES=~/Downloads,~/Documents,~/Desktop
